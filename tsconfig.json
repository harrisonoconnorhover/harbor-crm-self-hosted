{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "db/postgres/**/*.ts",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "lib/**/*.mts",
    "runtime/**/*.ts",
    "runtime/**/*.tsx",
    "cloudflare-env.d.ts",
    "vite.portable.config.ts",
    "vite.portable-worker.config.ts",
    "drizzle.portable.config.ts",
    "instrumentation.ts"
  ]
}
